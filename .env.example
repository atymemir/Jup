# Hosted MVP: dedicated Supabase Jup project, with migrations 101–111 and access_grants.
# Never use preview accounts on Vercel or reuse another project's server key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional Telegram integration, server only
SUPABASE_SERVICE_ROLE_KEY=
FINDBUDDY_TELEGRAM_BOT_USERNAME=jup_edu_app
FINDBUDDY_TELEGRAM_BOT_TOKEN=
FINDBUDDY_TELEGRAM_WEBHOOK_SECRET=
FINDBUDDY_PUBLIC_URL=https://findbuddy-kohl.vercel.app/findbuddy
# Set when enabling the reminder scheduler
CRON_SECRET=

# Optional built-in video (server only, LiveKit cloud or self-hosted)
FINDBUDDY_VIDEO_URL=
FINDBUDDY_VIDEO_KEY=
FINDBUDDY_VIDEO_SECRET=

# Optional AI text drafts, server only; templates work without a key.
JUP_AI_API_KEY=
JUP_AI_MODEL=gpt-4.1-mini
