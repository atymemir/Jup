{
  "name": "findbuddy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "FINDBUDDY_PREVIEW=1 next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "FINDBUDDY_PREVIEW=1 next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint app",
    "telegram:check": "node --env-file-if-exists=.env.local scripts/setup-telegram.mjs --check",
    "telegram:setup": "node --env-file-if-exists=.env.local scripts/setup-telegram.mjs",
    "telegram:commands": "node scripts/setup-telegram.mjs --commands",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@livekit/components-react": "2.9.26",
    "@livekit/components-styles": "1.2.0",
    "@supabase/supabase-js": "2.106.0",
    "livekit-client": "2.25.0",
    "livekit-server-sdk": "2.20.1",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "typescript": "~5.9.3"
  }
}
